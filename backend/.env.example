# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

FLASK_ENV=development
SECRET_KEY=dev-secret-change-me

# T02 — PostgreSQL schema and migrations
# Shared Supabase project — get this from Project Settings > Database > Connection
# string > URI in the team's Supabase dashboard, NOT a new project of your own.
# Local Postgres also works for solo dev if you don't have the Supabase string yet:
#   DATABASE_URL=postgresql://ofs:ofs@localhost:5432/ofs_dev
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# T10 — Payments with Stripe test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# T11 — Address Validation and Delivery Zone check
MAPBOX_ACCESS_TOKEN=pk....

# T14 — Route Optimizer via Mapbox Optimization
# (uses the same MAPBOX_ACCESS_TOKEN above)

# T17 — Notifications over SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=...
SMTP_FROM=no-reply@ofs.example
