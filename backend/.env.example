# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

FLASK_ENV=development
SECRET_KEY=dev-secret-change-me

# T02 — PostgreSQL schema and migrations
# Shared Supabase project: the owner sends you this privately. Dashboard: Connect >
# Connection string > Method: Session pooler (the direct db.*.supabase.co address needs IPv6).
# Keep ?sslmode=require. A DATABASE_URL exported in your terminal overrides this file.
# For a private local DB instead: DATABASE_URL=sqlite:///demo.db, then python seed_demo.py
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# T10 — Payments with Stripe test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# T11 — Address Validation and Delivery Zone check
MAPBOX_ACCESS_TOKEN=pk....

# T14 — Route Optimizer via Mapbox Optimization
# (uses the same MAPBOX_ACCESS_TOKEN above)

# T17 — Notifications over SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=...
SMTP_FROM=no-reply@ofs.example
# Set to 0 for a local test SMTP server without TLS. Without SMTP_HOST, emails are recorded as 'skipped'.
# SMTP_STARTTLS=1
